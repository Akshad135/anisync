{
  "schemaVersion": 1,
  "id": "akshad135.anisync",
  "name": "AniSync",
  "version": "1.0.2",
  "author": "Akshad Agrawal",
  "license": "MIT",
  "description": "Anime & Manga release tracker with AniList and MyAnimeList sync, countdown timers, and desktop notifications",
  "icon": "assets/anisync.svg",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "AniSync",
    "icon": "assets/anisync.svg",
    "description": "Track anime and manga release schedules with AniList and MyAnimeList sync",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "provider": "anilist",
      "userName": "akshad",
      "checkIntervalMins": 30,
      "enableAnimeNotifications": true,
      "enableMangaNotifications": true
    }
  }
}
